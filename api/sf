#!/usr/bin/env -S bun --loader=:ts

import { write, fetch } from "bun";
import { Glob } from "bun";
import { resolve, relative, dirname, join } from "node:path";
import { mkdir, rm } from "node:fs/promises";
import { watch } from "node:fs";

const PB_VERSION = "0.40.5";

async function getPb() {
  console.log("Descargando release")
  const response = await fetch(`https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip`);
  await write('pb.zip', response);
}

async function processRelease() {
  console.log("Descomprimiento...");
  const unzipPr = Bun.spawn(["unzip", "pb.zip", "-d", "./tmp"]);
  await unzipPr.exited;

  const rmZipPr = Bun.spawn(["rm", "pb.zip"]);
  await rmZipPr.exited;

  const mvPr = Bun.spawn(["mv", "./tmp/pocketbase", "./pb"]);
  await mvPr.exited;

  const chmodPr = Bun.spawn(["chmod", "+x", "./pb"]);
  await chmodPr.exited;

  const rmPbPr = Bun.spawn(["rm", "-rf", "./tmp"]);
  await rmPbPr.exited;
}

const commands = {

  setup: async () => {
    await getPb();
    await processRelease();
    console.log("Proceso finalizado");
  },

  build: async () => {
    const root = process.cwd();
    const srcDir = resolve(root, "src");
    const hooksDir = resolve(srcDir, "hooks");
    const libDir = resolve(srcDir, "lib");

    const outDir = resolve(root, "pb_hooks");
    const outLibDir = resolve(outDir, "lib");

    // Limpiar salida anterior
    await rm(outDir, { recursive: true, force: true });

    // Descubrir archivos TypeScript
    const getFiles = (dir: string): string[] =>
      Array.from(
        new Glob("**/*.ts").scanSync({
          cwd: dir,
          absolute: true,
          onlyFiles: true,
        })
      ).filter((file) => !file.endsWith(".d.ts"));

    // 1. Compilar librerías CommonJS
    const libs = getFiles(libDir);

    if (libs.length > 0) {
      const result = await Bun.build({
        entrypoints: libs,
        outdir: outLibDir,
        root: libDir,
        target: "browser",
        format: "cjs",
        splitting: false,
        minify: false,
        sourcemap: "none",
        naming: "[dir]/[name].js",
      });

      if (!result.success) {
        console.error(result.logs);
        process.exit(1);
      }

      console.log(`Libraries compiled: ${libs.length}`);
    }

    // 2. Transpilar hooks
    const transpiler = new Bun.Transpiler({
      loader: "ts",
      target: "browser",
    });

    const hooks = getFiles(hooksDir);

    for (const hook of hooks) {
      const source = await Bun.file(hook).text();
      const output = transpiler.transformSync(source);

      const relativePath = relative(hooksDir, hook);

      const destination = join(
        outDir,
        relativePath.replace(/\.ts$/, ".pb.js")
      );

      await mkdir(dirname(destination), {
        recursive: true,
      });

      await Bun.write(destination, output);

      console.log(`Hook compiled: ${relativePath}`);
    }

    console.log("TypeScript files build completed successfully");
  },

  watch: async () => {
    const root = process.cwd();
    const srcDir = resolve(root, "src");

    const directories = [
      resolve(srcDir, "hooks"),
      resolve(srcDir, "lib"),
    ];

    let timeout: ReturnType<typeof setTimeout> | undefined;
    let building = false;
    let pending = false;

    async function build() {
      if (building) {
        pending = true;
        return;
      }

      building = true;

      try {
        console.log("\nBuilding PocketBase hooks...");

        const process = Bun.spawn(
          ["bun", "run", "src/build.ts"],
          {
            cwd: root,
            stdout: "inherit",
            stderr: "inherit",
          }
        );

        const exitCode = await process.exited;

        if (exitCode === 0) {
          console.log("Build completed successfully");
        } else {
          console.error(`Build failed: ${exitCode}`);
        }
      } finally {
        building = false;

        if (pending) {
          pending = false;
          await build();
        }
      }
    }

    // Compilación inicial
    await build();

    // Monitorear hooks y librerías
    for (const directory of directories) {
      watch(
        directory,
        { recursive: true },
        (event, filename) => {
          if (!filename?.endsWith(".ts")) return;

          console.log(`Changed: ${filename}`);

          // Debounce para evitar múltiples builds
          clearTimeout(timeout);

          timeout = setTimeout(() => {
            void build();
          }, 150);
        }
      );

      console.log(`Watching: ${directory}`);
    }
  }

}


const command = Bun.argv[2];

const commandHandler = commands[command]

if ((!command || command=='') || !commandHandler) {
  console.error('Command not found');
  process.exit(-1)
}

commandHandler();
