{
  "name": "pb-hooks-bun",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build:ts": "bun run src/build.ts",
    "watch:ts": "bun --env-file=.env run src/watch.ts",
    "serve:pb": "bun --env-file=.env run serve:pb:process",
    "serve:pb:process": "./pb serve --dev",
    "dev": "bun run build:ts && concurrently -k \"bun run watch:ts --skip-initial\" \"bun run serve:pb\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^10.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
