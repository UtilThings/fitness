{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2020"]
  },
  "include": [
    "src/**/*.ts",
    "pb_data/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "pb_hooks"
  ]
}
