---
import {
  formatMessage,
  type Message,
  type MessageKey,
  type Params,
} from '@/i18n';
import { messageData } from '@/i18n/attrs';

type Props =
  | { k: string; params?: Params; message?: never }
  | { message: MessageKey | Message; k?: never; params?: never };

const { message, k, params } = Astro.props;
const text =
  typeof message === 'object' ? message : { key: message ?? k, params };
---

<span {...messageData(text.key, text.params)}>
  {formatMessage(text.key, text.params, 'en')}
</span>
