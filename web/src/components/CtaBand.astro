---
import T from '@/components/T.astro';
---

<section class="bg-primary text-primary-foreground">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-16 md:flex-row md:items-center">
    <div>
      <h2 class="text-4xl md:text-6xl">
        <T k="ctaTitle" />
      </h2>
      <p class="mt-3 max-w-xl font-medium">
        <T k="ctaSub" />
      </p>
    </div>
    <a
      href="/schedule"
      class="btn bg-background text-foreground hover:-translate-y-0.5"
    >
      <T k="book" />
    </a>
  </div>
</section>
