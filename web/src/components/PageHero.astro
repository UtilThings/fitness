---
import { Image } from 'astro:assets';
import T from '@/components/T.astro';
import type { Message } from '@/i18n';
import { messageAttrs } from '@/i18n/attrs';

interface Props {
  eyebrow?: Message;
  title: Message;
  sub: Message;
  alt?: Message;
  img?: ImageMetadata;
}

const { eyebrow, title, sub, img, alt } = Astro.props;
---

<section class="relative overflow-hidden">
  {img && (
    <Image
      src={img}
      alt=""
      {...messageAttrs({ alt })}
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      loading="eager"
    />
  )}
  <div class="absolute inset-0 hero-fade"></div>
  <div class="relative mx-auto max-w-7xl px-5 pt-28 pb-16 md:pt-40">
    <p class="eyebrow">{eyebrow && <T message={eyebrow} />}</p>
    <h1 class="mt-3 max-w-4xl text-5xl md:text-8xl">
      <T message={title} />
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
      <T message={sub} />
    </p>
  </div>
</section>
