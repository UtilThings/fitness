---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  sub: string;
  img?: ImageMetadata;
}

const { eyebrow, title, sub, img } = Astro.props;
---

<section class="relative overflow-hidden">
  {img && (
    <Image
      src={img}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      loading="eager"
    />
  )}
  <div class="absolute inset-0 hero-fade"></div>
  <div class="relative mx-auto max-w-7xl px-5 pt-28 pb-16 md:pt-40">
    <p class="eyebrow">
      <slot name="eyebrow">{eyebrow}</slot>
    </p>
    <h1 class="mt-3 max-w-4xl text-5xl md:text-8xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground">{sub}</p>
  </div>
</section>
