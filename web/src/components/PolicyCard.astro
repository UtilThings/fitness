---
import T from '@/components/T.astro';
import { tl, type Message, type MessageKey } from '@/i18n';

interface Props {
  items: MessageKey[];
  title?: Message;
}

const { items, title = { key: tl('Policies') } } = Astro.props;
---

<div class="card-surface p-7">
  <p class="eyebrow mb-4">
    <T message={title} />
  </p>
  <ul class="space-y-2 text-sm text-muted-foreground">
    {items.map((item) => (
      <li>
        • <T message={item} />
      </li>
    ))}
  </ul>
</div>
