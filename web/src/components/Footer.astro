---
import type { PublicBusiness } from '@/lib/api';
import T from '@/components/T.astro';
import { navigation } from '@/lib/navigation';
interface Props {
  business: PublicBusiness;
  logoSrc: string;
}
const { business, logoSrc } = Astro.props;
const words = business.name.trim().split(/\s+/);
const prefix = words.slice(0, -1).join(' ');
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3">
    <div class="space-y-3">
      <a
        href="/"
        aria-label={`${business.name} — home`}
        class="flex items-center gap-2.5"
      >
        <img src={logoSrc} alt={`${business.name} logo`} class="h-10 w-auto" />
        <span class="font-display text-2xl uppercase tracking-wide">
          {prefix} <span class="text-primary">{words.at(-1)}</span>
        </span>
      </a>
      <p class="text-sm text-muted-foreground">
        Boutique personal training &amp; small-group fitness in {business.city}.
      </p>
    </div>
    <nav aria-label="Footer menu" class="grid grid-cols-2 gap-2 text-sm">
      {navigation.map(({ key, href }) => (
        <a class="text-muted-foreground hover:text-primary" href={href}>
          <T k={key} />
        </a>
      ))}
    </nav>
    <div class="text-sm text-muted-foreground">
      <p class="eyebrow mb-2">Studio</p>
      <p>{business.city}</p>
      <a class="mt-4 inline-block text-primary" href="/contact">
        <T k="contact" /> →
      </a>
    </div>
  </div>
  <p class="pb-8 text-center text-xs text-muted-foreground">
    © {new Date().getFullYear()} {business.name}. All rights reserved.
  </p>
</footer>
