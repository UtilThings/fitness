---
import { formatPrice, type Plan } from '@/lib/data';

interface Props {
  plan: Plan;
  featured?: boolean;
  cta?: string;
  to?: string;
}

const {
  plan,
  featured = false,
  cta = 'Inquire now',
  to = '/contact',
} = Astro.props;
---

<div
  class:list={[
    'card-surface flex flex-col p-7',
    { 'border-primary': featured },
  ]}
>
  {featured && (
    <span class="mb-3 self-start rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase text-accent-foreground">
      Most popular
    </span>
  )}
  <h3 class="text-2xl">{plan.name}</h3>
  <p class="mt-4 font-display text-5xl text-primary">
    {formatPrice(plan.price)}
  </p>
  <p class="text-sm text-muted-foreground">{plan.unit}</p>
  <ul class="my-6 space-y-2 text-sm">
    {[plan.sessions, plan.freq, plan.note].filter(Boolean).map((item) => (
      <li class="flex gap-2">
        <svg
          class="h-4 w-4 shrink-0 text-primary"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m20 6-11 11-5-5" />
        </svg>
        {item}
      </li>
    ))}
  </ul>
  <a
    href={to}
    class:list={['btn mt-auto', featured ? 'btn-primary' : 'btn-outline']}
  >
    {cta}
  </a>
</div>
