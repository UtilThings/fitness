---
import group from '@/assets/group.jpg';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import PolicyCard from '@/components/PolicyCard.astro';
import PricingCard from '@/components/PricingCard.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { classTemplates, groupPlans } from '@/lib/data';

const times = classTemplates
  .filter(({ day, service }) => day === 2 && service === 'Group Strength')
  .map(({ time }) => time);
const policies = [
  'Classes are 60 minutes, capped at 6 participants.',
  '8-class packs expire after 4 weeks.',
  '16-week commitment is billed every 4 weeks for 4 periods.',
  'Cancel at least 12 hours before class to keep your credit.',
];
---

<BaseLayout
  title="Group Strength Training | JQ Fitness"
  description="Small-group strength classes, max 6 people. Tuesdays & Thursdays at 9:00 AM, 5:30 PM and 7:00 PM."
>
  <PageHero
    eyebrow="Group Strength"
    title="Small group. Big results."
    img={group}
    sub="Coached strength training with a maximum of 6 people per class — the attention of personal training with the energy of a team."
  />
  <Section>
    <div class="grid gap-6 md:grid-cols-3">
      {groupPlans.map((plan, index) => (
        <PricingCard
          {plan}
          featured={index === 0}
          cta="Book a class"
          to="/schedule"
        />
      ))}
      <div class="card-surface flex flex-col p-7">
        <h3 class="text-2xl">Drop-in &amp; Intro</h3>
        <p class="mt-4 text-muted-foreground">
          Single drop-in classes available. New here? Ask about a free
          introductory class.
        </p>
        <a href="/contact" class="btn btn-outline mt-auto">
          Ask about intro
        </a>
      </div>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="card-surface p-7">
        <p class="eyebrow mb-4">Weekly schedule</p>
        <p class="font-display text-3xl uppercase">Tuesday &amp; Thursday</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {times.map((time) => (
            <span class="rounded-full border border-primary px-4 py-2 font-bold text-primary">
              {time}
            </span>
          ))}
        </div>
      </div>
      <PolicyCard items={policies} />
    </div>
  </Section>
  <CtaBand />
</BaseLayout>
