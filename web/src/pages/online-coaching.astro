---
import { tl } from '@/i18n';
import T from '@/components/T.astro';
import LeadForm from '@/components/LeadForm.vue';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const benefits = [
  [
    tl('Training plans'),
    tl('Custom programming you can follow at home or in any gym.'),
  ],
  [
    tl('Nutrition guidance'),
    tl('Practical habits and targets that fit your lifestyle.'),
  ],
  [tl('8–16 week programs'), tl('Structured phases with a clear finish line.')],
  [tl('Progress monitoring'), tl('Regular check-ins and adjustments.')],
];
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={{
    key: tl("Online Coaching Programs {'|'} {name}"),
    params: { name: business.name },
  }}
  description="Personalized 8–16 week online coaching with training plans, nutrition guidance and progress monitoring."
>
  <PageHero
    eyebrow={{ key: tl('Online Coaching') }}
    title={{ key: tl('Coaching anywhere.') }}
    sub={{
      key: tl(
        'Get {name} programming and accountability wherever you are. Start with a free consultation.',
      ),
      params: { name: business.name },
    }}
  />
  <Section class="grid gap-10 lg:grid-cols-2">
    <div class="grid gap-4 sm:grid-cols-2">
      {benefits.map(([title, sub]) => (
        <div class="card-surface p-6">
          <h3 class="text-2xl text-primary">
            <T message={title} />
          </h3>
          <p class="mt-2 text-sm text-muted-foreground">
            <T message={sub} />
          </p>
        </div>
      ))}
      <p class="text-sm text-muted-foreground sm:col-span-2">
        <T k="Program pricing is shared after your consultation." />
      </p>
    </div>
    <LeadForm
      client:load
      title={tl('Request a consultation')}
      fields={[
        { kind: 'text', placeholder: tl('Full name'), required: true },
        { kind: 'email', placeholder: tl('Email'), required: true },
        { kind: 'text', placeholder: tl('Phone') },
        {
          kind: 'select',
          placeholder: tl('Program length'),
          options: [
            tl('8-week program'),
            tl('12-week program'),
            tl('16-week program'),
            tl('Not sure yet'),
          ],
        },
        {
          kind: 'textarea',
          placeholder: tl('Tell us about your goals'),
          rows: 4,
        },
      ]}
      submitLabel={tl('Submit application')}
      successMessage={tl("Thanks! We'll be in touch within 1–2 business days.")}
    />
  </Section>
</BaseLayout>
