---
import { Image } from 'astro:assets';
import hero from '@/assets/hero.jpg';
import personal from '@/assets/personal.jpg';
import group from '@/assets/group.jpg';
import jump from '@/assets/jump.jpg';
import CtaBand from '@/components/CtaBand.astro';
import Section from '@/components/Section.astro';
import T from '@/components/T.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dictionary } from '@/lib/i18n';

const programs = [
  {
    key: 'personal',
    href: '/personal-training',
    img: personal,
    sub: '1-on-1 and partner coaching built around your goals.',
  },
  {
    key: 'group',
    href: '/group-strength-training',
    img: group,
    sub: 'Max 6 people. Real coaching, real strength.',
  },
  {
    key: 'jump',
    href: '/tropical-jump',
    img: jump,
    sub: 'High-energy trampoline cardio. First class free.',
  },
] as const;

const words = [
  'Strength',
  'Energy',
  'Community',
  'Results',
  'Strength',
  'Energy',
  'Community',
];
const stats = [
  ['6', 'Max per strength class'],
  ['1:1', 'Personal coaching'],
  ['7', 'Weekly group classes'],
];
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={`${business.name} — Stronger Every Day | ${business.city}`}
  description={`Personal training, small-group strength and Tropical Jump classes in ${business.city}. Book your class today.`}
>
  <section class="relative -mt-16 flex min-h-[92vh] items-end overflow-hidden">
    <Image
      src={hero}
      alt={`Athlete training with a kettlebell at ${business.name}`}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 hero-fade"></div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-20">
      <p class="eyebrow">{business.city}</p>
      <h1 class="mt-4 text-6xl sm:text-8xl lg:text-[9rem]">
        <T k="heroTitle" />
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground">
        <T k="heroSub" />
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/schedule">
          <T k="book" />
        </a>
        <a class="btn btn-outline" href="/pricing">
          <T k="explore" />
        </a>
      </div>
    </div>
  </section>
  <div class="overflow-hidden border-y border-border bg-surface py-5">
    <p class="whitespace-nowrap font-display text-3xl uppercase text-muted-foreground">
      {words.map((word, index) => (
        <>
          {index > 0 && (
            <span class={index % 2 === 1 ? 'text-primary' : 'text-accent'}>
              {' '}
              •{' '}
            </span>
          )}
          {word}
        </>
      ))}
    </p>
  </div>
  <Section>
    <p class="eyebrow">
      <T k="programs" />
    </p>
    <h2 class="mt-3 text-5xl md:text-7xl">Train your way.</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {programs.map(({ key, href, img, sub }) => (
        <a
          class="card-surface group overflow-hidden hover:-translate-y-1"
          href={href}
        >
          <Image
            src={img}
            alt={dictionary.en[key]}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
          />
          <div class="p-6">
            <h3 class="text-3xl">
              <T k={key} />
            </h3>
            <p class="mt-2 text-muted-foreground">{sub}</p>
            <p class="mt-4 text-sm font-bold uppercase tracking-widest text-primary">
              <T k="learnMore" /> →
            </p>
          </div>
        </a>
      ))}
    </div>
    <a
      class="card-surface mt-6 flex flex-col justify-between gap-4 p-8 md:flex-row md:items-center"
      href="/online-coaching"
    >
      <div>
        <h3 class="text-3xl">
          <T k="online" />
        </h3>
        <p class="mt-2 text-muted-foreground">
          8–16 week programs with training plans, nutrition guidance and
          progress check-ins.
        </p>
      </div>
      <span class="btn btn-accent">Apply</span>
    </a>
  </Section>
  <Section class="grid gap-10 md:grid-cols-3">
    {stats.map(([value, label]) => (
      <div class="border-l-2 border-primary pl-6">
        <p class="font-display text-7xl text-primary">{value}</p>
        <p class="mt-2 uppercase tracking-widest text-muted-foreground">
          {label}
        </p>
      </div>
    ))}
  </Section>
  <CtaBand />
</BaseLayout>
