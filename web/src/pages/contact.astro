---
import { tl } from '@/i18n';
import LeadForm from '@/components/LeadForm.vue';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={`Contact ${business.name} | ${business.city}`}
  description={`Questions about training, classes or packages? Get in touch with ${business.name}.`}
>
  <PageHero
    eyebrow="Contact"
    title="Let's get started."
    sub="Tell us what you're interested in and we'll help you find the right program."
  />
  <Section class="grid gap-10 !pt-0 lg:grid-cols-2">
    <div class="space-y-6">
      <div class="card-surface p-7">
        <p class="eyebrow mb-2">Location</p>
        <p class="text-xl">{business.city}</p>
      </div>
      <div class="card-surface p-7">
        <p class="eyebrow mb-2">Programs</p>
        <p class="text-muted-foreground">
          Personal Training · Group Strength · Tropical Jump · Online Coaching
        </p>
      </div>
    </div>
    <LeadForm
      client:load
      fields={[
        { kind: 'text', placeholder: tl('Full name'), required: true },
        { kind: 'email', placeholder: tl('Email'), required: true },
        {
          kind: 'select',
          placeholder: tl('Program'),
          options: [
            tl('Personal Training'),
            tl('Group Strength'),
            tl('Tropical Jump'),
            tl('Online Coaching'),
            tl('Other'),
          ],
        },
        { kind: 'textarea', placeholder: tl('Message'), rows: 5 },
      ]}
      submitLabel={tl('Send message')}
      successMessage={tl("Thanks! We'll get back to you shortly.")}
    />
  </Section>
</BaseLayout>
