---
import { tl } from '@/i18n';
import T from '@/components/T.astro';
import group from '@/assets/group.jpg';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const values = [
  [
    tl('Energetic'),
    tl('Every session is built to leave you better than you came in.'),
  ],
  [tl('Welcoming'), tl('All levels, all backgrounds. Start where you are.')],
  [
    tl('Results-focused'),
    tl('Smart programming and accountability that actually works.'),
  ],
];
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={{
    key: tl("About {name} {'|'} {city} Boutique Studio"),
    params: { name: business.name, city: business.city.split(',')[0] },
  }}
  description={`A community-driven boutique fitness studio in ${business.city} focused on real results.`}
>
  <PageHero
    eyebrow={{ key: tl('About') }}
    title={{ key: tl('Built on community.') }}
    img={group}
    sub={{
      key: tl(
        '{name} is a boutique studio in {city} where coaching is personal, classes stay small, and every client is part of the team.',
      ),
      params: { name: business.name, city: business.city },
    }}
  />
  <Section class="grid gap-6 md:grid-cols-3">
    {values.map(([title, sub]) => (
      <div class="card-surface p-7">
        <h2 class="text-3xl text-primary">
          <T message={title} />
        </h2>
        <p class="mt-3 text-muted-foreground">
          <T message={sub} />
        </p>
      </div>
    ))}
  </Section>
  <CtaBand />
</BaseLayout>
