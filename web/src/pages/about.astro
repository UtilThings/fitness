---
import group from '@/assets/group.jpg';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const values = [
  ['Energetic', 'Every session is built to leave you better than you came in.'],
  ['Welcoming', 'All levels, all backgrounds. Start where you are.'],
  [
    'Results-focused',
    'Smart programming and accountability that actually works.',
  ],
];
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={`About ${business.name} | ${business.city.split(',')[0]} Boutique Studio`}
  description={`A community-driven boutique fitness studio in ${business.city} focused on real results.`}
>
  <PageHero
    eyebrow="About"
    title="Built on community."
    img={group}
    sub={`${business.name} is a boutique studio in ${business.city} where coaching is personal, classes stay small, and every client is part of the team.`}
  />
  <Section class="grid gap-6 md:grid-cols-3">
    {values.map(([title, sub]) => (
      <div class="card-surface p-7">
        <h2 class="text-3xl text-primary">{title}</h2>
        <p class="mt-3 text-muted-foreground">{sub}</p>
      </div>
    ))}
  </Section>
  <CtaBand />
</BaseLayout>
