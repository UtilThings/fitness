---
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import PricingGrid from '@/components/PricingGrid.vue';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog, type PlanGroup } from '@/lib/catalog';

const catalog = await getCatalog();
const sections: { title: string; group: PlanGroup; cta: string; to: string }[] =
  [
    {
      title: 'Personal Training — 1-on-1',
      group: 'personalOneOnOne',
      cta: 'Inquire now',
      to: '/contact',
    },
    {
      title: 'Personal Training — Partner',
      group: 'personalPartner',
      cta: 'Inquire now',
      to: '/contact',
    },
    {
      title: 'Group Strength',
      group: 'groupPlans',
      cta: 'Book now',
      to: '/schedule',
    },
    {
      title: 'Tropical Jump',
      group: 'jumpPlans',
      cta: 'Book now',
      to: '/schedule',
    },
  ];
---

<BaseLayout
  title="Pricing & Packages | JQ Fitness"
  description="Explore personal training packages, Group Strength memberships and Tropical Jump classes."
>
  <PageHero
    eyebrow="Pricing & Packages"
    title="Invest in stronger."
    sub="Transparent pricing. Packages billed in 4-week blocks unless noted. Online coaching pricing shared after consultation."
  />
  {sections.map(({ title, group, cta, to }) => (
    <Section class="!py-10">
      <h2 class="text-4xl">{title}</h2>
      <PricingGrid
        client:load
        class="mt-6"
        plans={catalog[group]}
        {group}
        {cta}
        {to}
      />
    </Section>
  ))}
  <CtaBand />
</BaseLayout>
