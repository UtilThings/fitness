---
import { tl, type MessageKey } from '@/i18n';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import PricingGrid from '@/components/PricingGrid.vue';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog, type PlanGroup } from '@/lib/catalog';

const catalog = await getCatalog();
const { business } = catalog;
const sections: {
  title: string;
  group: PlanGroup;
  cta: MessageKey;
  to: string;
}[] = [
  {
    title: 'Personal Training — 1-on-1',
    group: 'personalOneOnOne',
    cta: tl('Inquire now'),
    to: '/contact',
  },
  {
    title: 'Personal Training — Partner',
    group: 'personalPartner',
    cta: tl('Inquire now'),
    to: '/contact',
  },
  {
    title: 'Group Strength',
    group: 'groupPlans',
    cta: tl('Book now'),
    to: '/schedule',
  },
  {
    title: 'Tropical Jump',
    group: 'jumpPlans',
    cta: tl('Book now'),
    to: '/schedule',
  },
];
---

<BaseLayout
  business={business}
  title={`Pricing & Packages | ${business.name}`}
  description="Explore personal training packages, Group Strength memberships and Tropical Jump classes."
>
  <PageHero
    eyebrow="Pricing & Packages"
    title="Invest in stronger."
    sub="Transparent pricing. Packages billed in 4-week blocks unless noted. Online coaching pricing shared after consultation."
  />
  {sections.map(({ title, group, cta, to }) => (
    <Section class="!py-10">
      <h2 class="text-4xl">{title}</h2>
      <PricingGrid
        client:load
        class="mt-6"
        plans={catalog[group]}
        currency={business.currency}
        {group}
        {cta}
        {to}
      />
    </Section>
  ))}
  <CtaBand />
</BaseLayout>
