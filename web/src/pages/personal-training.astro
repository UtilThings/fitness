---
import { tl } from '@/i18n';
import T from '@/components/T.astro';
import personal from '@/assets/personal.jpg';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import PolicyCard from '@/components/PolicyCard.astro';
import PricingGrid from '@/components/PricingGrid.vue';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog } from '@/lib/catalog';

const { personalOneOnOne, personalPartner, business } = await getCatalog();

const policies = [
  tl('Each session is 60 minutes; packages run in 4-week blocks.'),
  tl('Sessions expire at the end of each 4-week block.'),
  tl(
    'Purchase does not reserve a set time — request your preferred slots and we confirm based on trainer availability.',
  ),
  tl('Reschedule or cancel at least 24 hours in advance to keep your session.'),
];

const included = [
  tl('Initial assessment & goal setting'),
  tl('Personalized program'),
  tl('Form coaching every session'),
  tl('Progress tracking'),
];
---

<BaseLayout
  business={business}
  title={{
    key: tl("Personal Training {'|'} {name} {city}"),
    params: { name: business.name, city: business.city.split(',')[0] },
  }}
  description="One-on-one and partner personal training packages in 4-week blocks."
>
  <PageHero
    eyebrow={{ key: tl('Personal Training') }}
    title={{ key: tl('Coaching built for you.') }}
    img={personal}
    sub={{
      key: tl(
        'One-on-one and partner sessions with a plan designed around your body, schedule and goals. Billed in 4-week blocks.',
      ),
    }}
  />
  <Section>
    <h2 class="text-4xl md:text-5xl">
      <T k="One-on-one" />
    </h2>
    <PricingGrid
      client:load
      class="mt-8"
      group="personalOneOnOne"
      plans={personalOneOnOne}
      currency={business.currency}
      featuredIndex={1}
      cta={tl('Request a schedule')}
    />
    <h2 class="mt-16 text-4xl md:text-5xl">
      <T k="Partner training" />
    </h2>
    <PricingGrid
      client:load
      class="mt-8"
      group="personalPartner"
      plans={personalPartner}
      currency={business.currency}
      cta={tl('Request a schedule')}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <PolicyCard items={policies} />
      <PolicyCard title={{ key: tl("What's included") }} items={included} />
    </div>
  </Section>
  <CtaBand />
</BaseLayout>
