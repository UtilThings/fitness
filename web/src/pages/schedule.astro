---
import PageHero from '@/components/PageHero.astro';
import ScheduleBoard from '@/components/ScheduleBoard.vue';
import Section from '@/components/Section.astro';
import { tl } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalog } from '@/lib/catalog';
const { business } = await getCatalog();
---

<BaseLayout
  business={business}
  title={{
    key: tl("Class Schedule {'|'} {name}"),
    params: { name: business.name },
  }}
  description="See upcoming Group Strength and Tropical Jump classes and remaining spots this week."
>
  <PageHero
    title={{ key: tl('Find your class.') }}
    sub={{
      key: tl(
        'Pick a day, check the open spots, and reserve. Online booking with accounts is coming soon.',
      ),
    }}
    eyebrow={{ key: tl('Schedule') }}
  />
  <Section class="min-h-[24rem] !pt-0">
    <ScheduleBoard client:only="vue" timezone={business.timezone} />
  </Section>
</BaseLayout>
