---
import { tl } from '@/i18n';
import T from '@/components/T.astro';
import jump from '@/assets/jump.jpg';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import PolicyCard from '@/components/PolicyCard.astro';
import PricingGrid from '@/components/PricingGrid.vue';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LocalTime from '@/components/LocalTime.astro';
import { weekdayKeys } from '@/lib/schedule';
import { getCatalog, SERVICE_SLUGS } from '@/lib/catalog';

const { classTemplates, jumpPlans, business } = await getCatalog();

const classes = classTemplates.filter(
  ({ serviceSlug }) => serviceSlug === SERVICE_SLUGS.jumpPlans,
);
const policies = [
  tl('First class free — one per client account.'),
  tl("Full class? Join the waitlist and we'll notify you if a spot opens."),
  tl('Cancel or reschedule at least 12 hours before class.'),
];
---

<BaseLayout
  business={business}
  title={{
    key: tl("Tropical Jump Trampoline Classes {'|'} {name}"),
    params: { name: business.name },
  }}
  description={`Explore high-energy trampoline fitness, class passes and the weekly schedule in ${business.city}.`}
>
  <PageHero
    eyebrow={{ key: tl('Tropical Jump') }}
    title={{ key: tl('Jump. Sweat. Vibe.') }}
    img={jump}
    sub={{
      key: tl(
        'A high-energy, low-impact trampoline workout set to tropical beats. Burn calories, build endurance, and have a blast.',
      ),
    }}
  />
  <Section>
    <PricingGrid
      client:load
      group="jumpPlans"
      plans={jumpPlans}
      currency={business.currency}
      featuredIndex={1}
      cta={tl('Book now')}
      to="/schedule"
    >
      <div class="card-surface p-7">
        <p class="eyebrow mb-4">
          <T k="Weekly classes" />
        </p>
        {classes.map(({ day, time }) => (
          <div class="flex justify-between border-b border-border py-3 last:border-0">
            <span class="font-display text-xl uppercase">
              <T message={weekdayKeys[day]} />
            </span>
            <LocalTime time={time} class="font-bold text-accent" />
          </div>
        ))}
      </div>
    </PricingGrid>
    <div class="mt-6">
      <PolicyCard items={policies} />
    </div>
  </Section>
  <CtaBand />
</BaseLayout>
