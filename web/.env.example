# URL pública del sitio. Obligatoria para compilar.
PUBLIC_SITE_URL=http://localhost:4321

# URL HTTP(S) de PocketBase para el catálogo y horario públicos. Si se omite, se usa el respaldo local.
PUBLIC_API_URL=

# Clave pública que genera el owner en Ajustes → Integración. Visible en el bundle.
PUBLIC_BUSINESS_KEY=

# Tiempo de espera por consulta en milisegundos (500–15000).
PUBLIC_API_TIMEOUT_MS=4000
