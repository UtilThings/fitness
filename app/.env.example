# URL base del servidor PocketBase (sin barra final). Obligatoria.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Clave de licencia de PrimeVue 5 (opcional). Sin ella PrimeVue muestra el aviso
# "Invalid PrimeUI License". Licencia comunitaria: https://primeui.dev/licenses/community
VITE_PRIMEVUE_LICENSE=

# Nombre que se muestra antes de iniciar sesión (opcional)
VITE_APP_NAME=Admin
